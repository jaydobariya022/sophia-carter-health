# Brevo Email Automation Environment Variables (Example Template)
PORT=3000
BASE_URL=http://localhost:3000

# Brevo API Key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Sender details in Brevo
BREVO_SENDER_EMAIL=support@sophiacarterhealth.com
BREVO_SENDER_NAME=Sophia Carter Health

# Optional Brevo Template ID (Transactional)
BREVO_PDF_TEMPLATE_ID=

# Optional Brevo List ID for Marketing Opt-ins
BREVO_CONTACT_LIST_ID=
